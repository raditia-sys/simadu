{
    "name": "simadu/backend",
    "description": "SIMADU Backend API",
    "require": {
        "phpoffice/phpspreadsheet": "^5.9",
        "phpoffice/phpword": "^1.4",
        "minishlink/web-push": "^11.0",
        "guzzlehttp/guzzle": "^8.0",
        "phpmailer/phpmailer": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Simadu\\": "src/"
        }
    },
    "config": {
        "vendor-dir": "vendor",
        "optimize-autoloader": true
    }
}
